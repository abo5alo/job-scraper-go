# Copy to .env on the server and fill in. Never commit .env.

# Database password. Letters and digits only, since it goes into a URL.
# Generate one with: openssl rand -hex 16
DB_PASSWORD=

# The site's address. With no domain, use the server's public IP written
# with dashes plus .sslip.io, e.g. 3-120-45-6.sslip.io for 3.120.45.6.
SITE_ADDRESS=

# Makes plain "docker compose ..." commands use the production setup.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
